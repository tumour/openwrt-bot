# openwrt-bot — конфиг. На роутере: /etc/openwrt-bot.env (chmod 600, только root).
# init.d читает построчно KEY=VAL, пустые строки и # игнорируются.

# Токен от @BotFather (обязательно)
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# Кто может командовать ботом — Telegram chat_id через запятую (обязательно)
ALLOWED_CHAT_IDS=123456789

# Бот ходит в Telegram через VPN-socks (Xray socks-inbound). Без этого из РФ
# api.telegram.org заблокирован. socks5:// → Go-http уважает этот прокси.
HTTPS_PROXY=socks5://127.0.0.1:10808

# Путь к DHCP-лизам для /list (дефолт OpenWrt)
DHCP_LEASES_PATH=/tmp/dhcp.leases

# Файл термозоны CPU для строки Temp в /status. Если на железе зоны нет —
# /status просто не покажет температуру (не ошибка). Менять, если CPU-датчик
# в другой зоне (проверить: cat /sys/class/thermal/thermal_zone*/type).
THERMAL_ZONE_PATH=/sys/class/thermal/thermal_zone0/temp

# Сервер librespeed для /speedtest. Требует пакет librespeed-cli на роутере
# (apk add librespeed-cli) — без него /speedtest подскажет, что доставить.
# Пусто = авто-выбор, но он прыгает (в списке мало РФ-серверов) → цифры скачут.
# Пин на 102 = Volzhsky, Russia (PowerNet) — единственный РФ-сервер в списке,
# меряет ёмкость домашнего канала без приграничного throttle. Сменить: на роутере
# `librespeed-cli --list`, взять ID.
SPEEDTEST_SERVER_ID=102

# debug | info | warn | error
LOG_LEVEL=info
