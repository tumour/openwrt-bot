#!/bin/sh /etc/rc.common
# procd-сервис openwrt-bot — Telegram-бот управления роутером.
# Ходит в Telegram через VPN-socks (HTTPS_PROXY задаётся в env-файле).
# Bootstrap'ит nft-сеты banned_macs и vpn_direct_macs при старте —
# БЕЗ fw4 reload (безопасно для SSH).

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/openwrt-bot
# Конфиг и runtime-состояние бота живут в одном каталоге /etc/openwrt-bot/
# (по образцу /etc/xray/): env, в будущем users.json. Каталог вписан в
# /etc/sysupgrade.conf (см. deploy.sh) — переживает перепрошивку целиком.
ENV_FILE=/etc/openwrt-bot/env
NFT_TABLE="inet fw4"
NFT_SET="banned_macs"
NFT_DIRECT_SET="vpn_direct_macs"
NFT_RATE_TABLE="netdev openwrt_bot"
LAN_DEV="br-lan"

# Idempotent bootstrap nftables. Без fw4 reload — `nft add` вставляет в
# существующую таблицу, не пересобирает firewall. Всё runtime: reboot чистит,
# при следующем `bot on` пересоздаётся заново (set придёт пустым).
ensure_nft() {
    nft list set $NFT_TABLE $NFT_SET >/dev/null 2>&1 || \
        nft add set $NFT_TABLE $NFT_SET '{ type ether_addr; }'
    # Drop в forward — срабатывает когда LAN-wide VPN выключен.
    nft list chain $NFT_TABLE forward 2>/dev/null | grep -q "@$NFT_SET" || \
        nft add rule $NFT_TABLE forward ether saddr @$NFT_SET drop
    # Drop в prerouting ДО TPROXY. При включённом VPN (таблица ip xray) LAN-трафик
    # заворачивается в xray в prerouting (priority mangle = -150) раньше forward —
    # forward-drop в обход. Своя base-цепочка с priority mangle-10 (= -160) ловит
    # забаненный MAC раньше TPROXY, поэтому бан работает и с VPN, и без.
    nft list chain $NFT_TABLE ban_prerouting >/dev/null 2>&1 || \
        nft add chain $NFT_TABLE ban_prerouting '{ type filter hook prerouting priority mangle - 10 ; policy accept ; }'
    nft list chain $NFT_TABLE ban_prerouting 2>/dev/null | grep -q "@$NFT_SET" || \
        nft add rule $NFT_TABLE ban_prerouting ether saddr @$NFT_SET drop
    # VPN-обход per-device (/vpnoff в боте). Метка 0xff — анти-петля xray:
    # его prerouting-цепочка (ip xray, priority -150) делает `meta mark 0xff return`,
    # т.е. помеченный пакет уходит мимо TPROXY напрямую через ISP. Наша цепочка
    # ban_prerouting (-160) срабатывает раньше — метим трафик MAC'ов из сета.
    # Drop бана стоит в цепочке ПЕРВЫМ, поэтому бан сильнее обхода.
    # Таблицу ip xray не трогаем: сет живёт в fw4 и переживает vpn off/on.
    nft list set $NFT_TABLE $NFT_DIRECT_SET >/dev/null 2>&1 || \
        nft add set $NFT_TABLE $NFT_DIRECT_SET '{ type ether_addr; }'
    nft list chain $NFT_TABLE ban_prerouting 2>/dev/null | grep -q "@$NFT_DIRECT_SET" || \
        nft add rule $NFT_TABLE ban_prerouting ether saddr @$NFT_DIRECT_SET meta mark set 0xff
}

# Лимиты скорости per-device (/limit в боте). Family netdev обязателен: download
# по MAC ловится только на egress br-lan (там доступен ether daddr), upload — на
# ingress (ether saddr). Bridged LAN<->LAN трафик через эти хуки не проходит —
# не страдает; tproxy-нутый xray-трафик хукам виден. Отдельная таблица (не fw4):
# egress-чейны в inet не живут, зато netdev-таблицу не трогает fw4 reload.
# Скелет создаёт init.d, бот управляет только limit-объектами lim_{ul,dl}_<mac>
# и элементами map'ов. Runtime: reboot чистит, следующий `bot on` пересоздаёт
# пустым (лимиты слетают, как баны). Чейны требуют существующего $LAN_DEV:
# при START=95 мост давно поднят, но ручной `bot on` до сети создаст таблицу
# без чейнов — долечится следующим рестартом.
ensure_nft_rate() {
    nft list table $NFT_RATE_TABLE >/dev/null 2>&1 || \
        nft add table $NFT_RATE_TABLE
    nft list map $NFT_RATE_TABLE rate_ul >/dev/null 2>&1 || \
        nft add map $NFT_RATE_TABLE rate_ul '{ type ether_addr : limit ; }'
    nft list map $NFT_RATE_TABLE rate_dl >/dev/null 2>&1 || \
        nft add map $NFT_RATE_TABLE rate_dl '{ type ether_addr : limit ; }'
    nft list chain $NFT_RATE_TABLE lan_ingress >/dev/null 2>&1 || \
        nft add chain $NFT_RATE_TABLE lan_ingress "{ type filter hook ingress device $LAN_DEV priority filter ; policy accept ; }"
    nft list chain $NFT_RATE_TABLE lan_ingress 2>/dev/null | grep -q "@rate_ul" || \
        nft add rule $NFT_RATE_TABLE lan_ingress limit name ether saddr map @rate_ul counter drop
    nft list chain $NFT_RATE_TABLE lan_egress >/dev/null 2>&1 || \
        nft add chain $NFT_RATE_TABLE lan_egress "{ type filter hook egress device $LAN_DEV priority filter ; policy accept ; }"
    nft list chain $NFT_RATE_TABLE lan_egress 2>/dev/null | grep -q "@rate_dl" || \
        nft add rule $NFT_RATE_TABLE lan_egress limit name ether daddr map @rate_dl counter drop
}

start_service() {
    [ -f "$ENV_FILE" ] || { echo "openwrt-bot: нет $ENV_FILE — создай из openwrt-bot.env.example"; return 1; }
    [ -x "$PROG" ]     || { echo "openwrt-bot: нет $PROG"; return 1; }
    ensure_nft
    ensure_nft_rate

    procd_open_instance
    procd_set_param command "$PROG"
    # env из файла: KEY=VAL построчно, пропуская пустые строки и комментарии
    while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; esac
        procd_append_param env "$line"
    done < "$ENV_FILE"
    procd_set_param respawn          # авто-перезапуск при крахе
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# nft-set при остановке НЕ трогаем: баны переживают рестарт/краш бота.
